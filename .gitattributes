# 让 Git 自动判断文本/二进制，并在仓库内统一使用 LF
* text=auto eol=lf

# 源文件明确为文本
*.md      text
*.txt     text
*.json    text
*.yml     text
*.yaml    text
*.toml    text
*.sh      text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件不做行尾转换、不做 diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.7z      binary
*.gz      binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.mp4     binary
*.mp3     binary
